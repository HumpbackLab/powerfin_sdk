# Android Repo metadata is local checkout state.
/.repo/

# Projects managed by Android Repo, or intentionally absent from the
# PowerFin-only checkout. The SDK root repository does not track them.
/app/
/buildroot/
/external/*
!/external/common_algorithm/
!/external/alsa-config/
!/external/rkscript/
!/external/rktoolkit/
!/external/rkwifibt-app/
/hal/
/kernel-6.1/
/prebuilts/**
!/prebuilts/gcc/
!/prebuilts/gcc/linux-x86/
!/prebuilts/gcc/linux-x86/arm/
!/prebuilts/gcc/linux-x86/arm/gcc-arm-10.3-2021.07-x86_64-arm-none-linux-gnueabihf/
!/prebuilts/gcc/linux-x86/arm/gcc-arm-10.3-2021.07-x86_64-arm-none-linux-gnueabihf/**
/rtos/
/u-boot/
/yocto/

# Independent projects managed outside the SDK root repository.
/simulation/
/tools/penguin-flight-console/

# Links generated by Repo <linkfile> entries or SDK setup scripts.
/kernel
/rockdev
/linuxrc

# Top-level SDK build and packaging output.
/output/
/*.img
/*.zip
/*.tar
/*.tar.gz
/*.tar.xz
/*.log

# Local agent, editor and environment state.
/.agents/
/.codex/
/.idea/
/.vscode/
/.env
/.env.*
!/.env.example
*.swp
*.swo
*~

# Language and tooling caches that may be created at the SDK root.
/__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
**/cmake-build-*/
**/.cache/
**/.ninja_deps
**/.ninja_log
compile_commands.json

# Crash dumps and test coverage output.
core
core.*
*.gcda
*.gcno
coverage/
