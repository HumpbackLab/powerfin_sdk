# Android Repo metadata is local checkout state.
/.repo/

# Projects managed by Android Repo. The SDK root repository deliberately does
# not track these directories; each project is committed independently and the
# manifest records the version combination.
/app/
/buildroot/
/device/
/docs/
/external/
/hal/
/kernel-6.1/
/prebuilts/
/rkbin/
/rtos/
/tools/
/u-boot/
/yocto/

# Independent projects that will be added to the PowerFin manifest after their
# remotes have been created.
/manual/
/simulation/

# Links generated by Repo <linkfile> entries or SDK setup scripts.
/Makefile
/README.md
/build.sh
/common
/kernel
/overlay
/rkflash.sh
/rockdev
/linuxrc

# Top-level SDK build and packaging output.
/output/
/*.img
/*.zip
/*.tar
/*.tar.gz
/*.tar.xz
/*.log

# Local agent, editor and environment state.
/.agents/
/.codex/
/.idea/
/.vscode/
/.env
/.env.*
!/.env.example
*.swp
*.swo
*~

# Language and tooling caches that may be created at the SDK root.
/__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
**/cmake-build-*/
**/.cache/
**/.ninja_deps
**/.ninja_log
compile_commands.json

# Crash dumps and test coverage output.
core
core.*
*.gcda
*.gcno
coverage/

