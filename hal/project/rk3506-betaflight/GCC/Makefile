PROJECT := RK3506_BETAFLIGHT
SOC := RK3506
CPU := -mcpu=cortex-a7

BF_ROOT ?= $(abspath ../../../../../betaflight)

ENABLE_HAL_TESTS := n

CFLAGS := -O2 -mfloat-abi=hard
CFLAGS += -DBETAFLIGHT_BAREMETAL

FIRMWARE_CPU_BASE ?= 0x02e00000
DRAM_SIZE ?= 0x00100000
SHMEM_BASE ?= 0x02d00000
SHMEM_SIZE ?= 0x00100000
DSMC_SLAVE_MEM_BASE ?= 0x06000000
DSMC_SLAVE_MEM_SIZE ?= 0x02000000

CFLAGS += -DFIRMWARE_BASE=$(FIRMWARE_CPU_BASE) -DDRAM_SIZE=$(DRAM_SIZE)
CFLAGS += -DSHMEM_BASE=$(SHMEM_BASE) -DSHMEM_SIZE=$(SHMEM_SIZE)
CFLAGS += -DDSMC_SLAVE_MEM_BASE=$(DSMC_SLAVE_MEM_BASE)
CFLAGS += -DDSMC_SLAVE_MEM_SIZE=$(DSMC_SLAVE_MEM_SIZE)

INCLUDES += \
	-I"$(BF_ROOT)/src/main" \
	-I"$(BF_ROOT)/src/platform/RK3506/bringup"

SRC_DIRS += $(BF_ROOT)/src/platform/RK3506/bringup

LINKER_SCRIPT := gcc_arm.ld
CLEAN_FILES += $(LINKER_SCRIPT)

include ../../common/GCC/Cortex-A.mk
