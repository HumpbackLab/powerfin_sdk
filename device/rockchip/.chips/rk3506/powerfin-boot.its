/dts-v1/;
/ {
	description = "PowerFin normal and recovery boot image";

	images {
		fdt-normal {
			data = /incbin/("@KERNEL_DTB@");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
			load = <0xffffff00>;

			hash {
				algo = "sha256";
			};
		};

		fdt-recovery {
			data = /incbin/("@RECOVERY_KERNEL_DTB@");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
			load = <0xffffff00>;

			hash {
				algo = "sha256";
			};
		};

		fdt-motor-pwm {
			data = /incbin/("@MOTOR_PWM_DTBO@");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
			load = <0x000f0000>;

			hash {
				algo = "sha256";
			};
		};

		fdt-spi1-pwm {
			data = /incbin/("@SPI1_PWM_DTBO@");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
			load = <0x000f8000>;

			hash {
				algo = "sha256";
			};
		};

		kernel {
			data = /incbin/("@KERNEL_IMG@");
			type = "kernel";
			arch = "arm";
			os = "linux";
			compression = "none";
			entry = <0xffffff01>;
			load = <0xffffff01>;

			hash {
				algo = "sha256";
			};
		};

		ramdisk-recovery {
			data = /incbin/("@RAMDISK_IMG@");
			type = "ramdisk";
			arch = "arm";
			os = "linux";
			compression = "none";
			load = <0xffffff02>;

			hash {
				algo = "sha256";
			};
		};
	};

	configurations {
		default = "conf-normal";

		conf-normal {
			fdt = "fdt-normal";
			kernel = "kernel";
		};

		motor-pwm {
			fdt = "fdt-motor-pwm";
		};

		spi1-pwm {
			fdt = "fdt-spi1-pwm";
		};

		conf-recovery {
			fdt = "fdt-recovery";
			kernel = "kernel";
			ramdisk = "ramdisk-recovery";
		};
	};
};
